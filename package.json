{
  "name": "fitz",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.ts",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --dir app build && electron .",
    "check": "pnpm typecheck && pnpm --dir app lint && pnpm --dir app build && pnpm test && pnpm test:electron && pnpm test:e2e",
    "server": "node server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"server/**/*.test.ts\"",
    "test:electron": "ELECTRON_RUN_AS_NODE=1 electron --test \"server/**/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24",
    "electron": "^45.5.0",
    "typescript": "~6.0.2"
  }
}
