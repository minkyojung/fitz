{
  "name": "fitz",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "check": "pnpm typecheck && pnpm --dir app typecheck && pnpm test && pnpm test:electron",
    "server": "node server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"server/**/*.test.ts\"",
    "test:electron": "ELECTRON_RUN_AS_NODE=1 electron --test \"server/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24",
    "electron": "^45.5.0",
    "typescript": "~6.0.2"
  }
}
